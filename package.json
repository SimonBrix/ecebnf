{
  "name": "ecebnf",
  "displayName": "ECEBNF",
  "description": "Syntax highlighting for ECEBNF",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "ecebnf",
      "aliases": ["ECEBNF", "ecebnf"],
      "extensions": [".ecebnf"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "ecebnf",
      "scopeName": "source.ecebnf",
      "path": "./syntaxes/ecebnf.tmLanguage.json"
    }]
  }
}
