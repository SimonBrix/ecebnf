{
  "name": "ecebnf",
  "displayName": "ECEBNF",
  "description": "Syntax highlighting for ECEBNF",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ecebnf",
        "aliases": [
          "ECEBNF",
          "ecebnf"
        ],
        "extensions": [
          ".ecebnf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ecebnf",
        "scopeName": "source.ecebnf",
        "path": "./syntaxes/ecebnf.tmLanguage.json"
      },
      {
        "scopeName": "source.ecebnf.embedded",
        "path": "./syntaxes/ecebnf-embedded.tmLanguage.json",
        "injectTo": [
          "source.cpp"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SimonBrix/ecebnf"
  }
}